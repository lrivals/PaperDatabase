   "rows": [
    [
     "",
     "Attribute Description"
    ],
    [
     "OV",
     "Out-of-View (90): the target leaves the view."
    ],
    [
     "OC",
     "Occlusion (42): the target is partially or heavily oc- cluded"
    ],
    [
     "TC",
     "Thermal Crossover (256): the target has a similar tem- perature to other objects or background surroundings."
    ],
    [
     "FM",
     "Fast Motion (188): the target's motion between two adjacent frames is larger than 60 pixels."
    ],
    [
     "SV",
     "Scale Variation (84): the ratio of the bounding boxes of the first frame and the current frame is out of the range [0.66,1.5]."
    ],
    [
     "DBC",
     "Dynamic Background Clutter (77): there are dynamic changes in the background around the target"
    ]
