   "caption": "",
   "rows": [
    [
     "Algorithm 3 Layer Mapping Logic axi_address = DDR_BASE end if"
    ],
    [
     "Input: layer_id, data_size, BRAM_available_space, URAM_available_space Output: axi_address"
    ],
    [
     "if (layer_id >=1 && layer_id <= 10) then // Preferred: BRAM if (data_size <= BRAM_available_space) then axi_address = BRAM_BASE BRAM_available_space - = data_size else if (data_size <= URAM_available_space) then axi_address = URAM_BASE // Fallback to URAM URAM_available_space - = data_size else axi_address = DDR_BASE // Final fallback to DDR end if else if (layer_id>=11 layer_id<=21) then // Preferred: URAM if (data_size <= URAM_available_space) then axi_address = URAM_BASE URAM_available_space - = data_size else if (data_size <= BRAM_available_space) then axi_address = BRAM_BASE // Fallback to BRAM BRAM_available_space -= data_size else"
    ]
   ]
